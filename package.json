{
  "name": "nationwright",
  "private": true,
  "version": "0.0.0",
  "description": "A single-player nation simulator with procedurally generated worlds.",
  "license": "GPL-3.0-or-later",
  "author": "Nexxus Drako Multimedia",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run licenses",
    "data:fetch": "node packages/reference-data/src/cli.ts fetch",
    "data:build": "node packages/reference-data/src/cli.ts build",
    "licenses": "node scripts/check-licenses.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
