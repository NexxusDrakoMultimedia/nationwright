{
  "name": "nationwright",
  "private": true,
  "version": "0.0.0",
  "description": "A single-player nation simulator with procedurally generated worlds.",
  "license": "GPL-3.0-or-later",
  "author": "Nexxus Drako Multimedia",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.renderer.json && tsc -p packages/ui/tsconfig.preload.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run licenses",
    "data:fetch": "node packages/reference-data/src/cli.ts fetch",
    "data:build": "node packages/reference-data/src/cli.ts build",
    "licenses": "node scripts/check-licenses.ts",
    "nw": "node packages/cli/src/main.ts",
    "ui:build": "node packages/ui/build.ts",
    "ui:start": "npm run ui:build && electron packages/ui",
    "ui:smoke": "node packages/ui/smoke.ts",
    "ui:package": "npm run ui:build && cd packages/ui && electron-builder --config electron-builder.yml",
    "worldgen:validate": "node scripts/validate-worldgen.ts --out docs/validation/worldgen.md",
    "sim:validate": "node scripts/validate-simulation.ts --out docs/validation/simulation.md",
    "perf:measure": "node scripts/measure-performance.ts --out docs/validation/performance.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "rimraf": "file:tools/rimraf-compat",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@electron/asar": "^4.3.0",
    "temp": {
      "rimraf": "$rimraf"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NexxusDrakoMultimedia/nationwright.git"
  }
}
